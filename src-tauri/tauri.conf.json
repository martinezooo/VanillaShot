{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Vanilla Shoot",
  "version": "0.1.22",
  "identifier": "com.hackjitsu.vanillashoot",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Vanilla Shoot Settings",
        "width": 520,
        "height": 600,
        "minWidth": 460,
        "minHeight": 460,
        "resizable": true,
        "fullscreen": false,
        "transparent": false
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "vanillashoot"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
