# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Vendored at build time by scripts/vendor-tesseract.mjs
public/tesseract/

# `tauri icon` regenerates icon sets for every platform. This app targets
# macOS only, and tauri.conf.json references just the sizes kept in git.
src-tauri/icons/android/
src-tauri/icons/ios/
src-tauri/icons/Square*Logo.png
src-tauri/icons/StoreLogo.png

# Local test fixture, never shipped
public/__test-fixture.png

# Swift helpers compiled by build.rs and bundled as resources
src-tauri/gen/helpers/

# Local editor and tooling settings, per-contributor
.vscode/settings.json

# Secrets and key material - never commit these
.env
.env.*
*.p12
*.pem
*.key
*.mobileprovision
id_rsa*
